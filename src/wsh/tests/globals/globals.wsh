--
-- Example + regression driver for wsh globals tracing (globals_trace).
--
-- Loads a small target library with known globals, traces the global
-- variable accesses performed by two of its functions, and prints the
-- access log. run_test.sh checks this output against the expected set.
--
-- Copyright 2016-2026 Jonathan Brossard. MIT License.
--

loadbin("./libglobals_target.so")

-- Default scope: only the binary we just loaded (not wsh or libc).
globals_trace()

print("### bump")
bump()                  -- reads g_initialized, reads+writes g_counter
globals_show()

print("### copy_msg")
copy_msg()              -- reads g_rodata_msg, writes g_name and g_zero_bss
globals_show()

exit(0)
